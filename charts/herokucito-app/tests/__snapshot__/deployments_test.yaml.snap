renders deployment for a single service:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
        app.kubernetes.io/component: service
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.7
      name: RELEASE-NAME-backend
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/component: service
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: backend
      template:
        metadata:
          labels:
            app.kubernetes.io/component: service
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: backend
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: herokucito-app-0.2.7
        spec:
          containers:
            - env:
                - name: PORT
                  value: "8080"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: backend
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
              image: myregistry/backend:v1.0.0
              livenessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: http
                timeoutSeconds: 4
              name: backend
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              resources:
                limits:
                  cpu: 100m
                  memory: 256Mi
                requests:
                  cpu: 20m
                  memory: 64Mi
              startupProbe:
                failureThreshold: 60
                periodSeconds: 1
                tcpSocket:
                  port: http
                timeoutSeconds: 5
              volumeMounts:
                - mountPath: /tmp
                  name: tmp-volume
          serviceAccountName: RELEASE-NAME
          volumes:
            - emptyDir:
                medium: Memory
                sizeLimit: 100Mi
              name: tmp-volume
renders deployment with custom command:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
        app.kubernetes.io/component: service
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: worker
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v2.0.0
        helm.sh/chart: herokucito-app-0.2.7
      name: RELEASE-NAME-worker
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/component: service
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: worker
      template:
        metadata:
          labels:
            app.kubernetes.io/component: service
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: worker
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v2.0.0
            helm.sh/chart: herokucito-app-0.2.7
        spec:
          containers:
            - command:
                - ./run-worker
              env:
                - name: PORT
                  value: "9090"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: worker
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v2.0.0,deployment.environment.name=
              image: myregistry/worker:v2.0.0
              livenessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: http
                timeoutSeconds: 4
              name: worker
              ports:
                - containerPort: 9090
                  name: http
                  protocol: TCP
              resources:
                limits:
                  cpu: 500m
                  memory: 512Mi
                requests:
                  cpu: 100m
                  memory: 128Mi
              startupProbe:
                failureThreshold: 60
                periodSeconds: 1
                tcpSocket:
                  port: http
                timeoutSeconds: 5
              volumeMounts:
                - mountPath: /tmp
                  name: tmp-volume
          serviceAccountName: RELEASE-NAME
          volumes:
            - emptyDir:
                medium: Memory
                sizeLimit: 100Mi
              name: tmp-volume
renders deployment with pg:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
        app.kubernetes.io/component: service
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.7
      name: RELEASE-NAME-backend
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/component: service
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: backend
      template:
        metadata:
          labels:
            app.kubernetes.io/component: service
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: backend
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: herokucito-app-0.2.7
        spec:
          containers:
            - env:
                - name: PORT
                  value: "8080"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: backend
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
                - name: BANANASPLIT_DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      key: uri
                      name: RELEASE-NAME-somedb-app
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      key: uri
                      name: RELEASE-NAME-somedb-app
                - name: PGHOST
                  valueFrom:
                    secretKeyRef:
                      key: host
                      name: RELEASE-NAME-somedb-app
                - name: PGPORT
                  valueFrom:
                    secretKeyRef:
                      key: port
                      name: RELEASE-NAME-somedb-app
                - name: PGDATABASE
                  valueFrom:
                    secretKeyRef:
                      key: dbname
                      name: RELEASE-NAME-somedb-app
                - name: PGUSER
                  valueFrom:
                    secretKeyRef:
                      key: user
                      name: RELEASE-NAME-somedb-app
                - name: PGPASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: password
                      name: RELEASE-NAME-somedb-app
              image: myregistry/backend:v1.0.0
              livenessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: http
                timeoutSeconds: 4
              name: backend
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              resources:
                limits:
                  cpu: 100m
                  memory: 256Mi
                requests:
                  cpu: 20m
                  memory: 64Mi
              startupProbe:
                failureThreshold: 60
                periodSeconds: 1
                tcpSocket:
                  port: http
                timeoutSeconds: 5
              volumeMounts:
                - mountPath: /tmp
                  name: tmp-volume
          serviceAccountName: RELEASE-NAME
          volumes:
            - emptyDir:
                medium: Memory
                sizeLimit: 100Mi
              name: tmp-volume
renders deployment with secrets:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        reloader.stakater.com/auto: "true"
      labels:
        app.kubernetes.io/component: service
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.7
      name: RELEASE-NAME-backend
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/component: service
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: backend
      template:
        metadata:
          labels:
            app.kubernetes.io/component: service
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: backend
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: herokucito-app-0.2.7
        spec:
          containers:
            - env:
                - name: PORT
                  value: "8080"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: backend
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
              envFrom:
                - secretRef:
                    name: my-app-secrets
                - secretRef:
                    name: my-api-keys
              image: myregistry/backend:v1.0.0
              livenessProbe:
                failureThreshold: 3
                periodSeconds: 5
                tcpSocket:
                  port: http
                timeoutSeconds: 4
              name: backend
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              resources:
                limits:
                  cpu: 100m
                  memory: 256Mi
                requests:
                  cpu: 20m
                  memory: 64Mi
              startupProbe:
                failureThreshold: 60
                periodSeconds: 1
                tcpSocket:
                  port: http
                timeoutSeconds: 5
              volumeMounts:
                - mountPath: /tmp
                  name: tmp-volume
          serviceAccountName: RELEASE-NAME
          volumes:
            - emptyDir:
                medium: Memory
                sizeLimit: 100Mi
              name: tmp-volume
