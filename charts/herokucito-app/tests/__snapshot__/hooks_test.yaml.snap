renders hooks for pre-deploy and post-deploy using hardcoded images:
  1: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        argocd.argoproj.io/hook: Sync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
        argocd.argoproj.io/sync-wave: "-10"
      labels:
        app.kubernetes.io/component: hook
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: migrate
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.8
        herokucito.ludat.io/hook-type: pre-deploy
      name: RELEASE-NAME-pre-migrate
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/component: hook
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: migrate
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: herokucito-app-0.2.8
          name: RELEASE-NAME-pre-migrate
        spec:
          containers:
            - command:
                - ./migrate.sh
              env:
                - name: PORT
                  value: "8080"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: migrate
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
              image: myregistry/backend:v1.0.0
              name: migrate
              resources:
                limits:
                  cpu: 100m
                  memory: 256Mi
                requests:
                  cpu: 20m
                  memory: 64Mi
          restartPolicy: OnFailure
          serviceAccountName: RELEASE-NAME
  2: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        argocd.argoproj.io/hook: Sync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
        argocd.argoproj.io/sync-wave: "10"
      labels:
        app.kubernetes.io/component: hook
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: notify
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.8
        herokucito.ludat.io/hook-type: post-deploy
      name: RELEASE-NAME-post-notify
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/component: hook
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: notify
            app.kubernetes.io/part-of: herokucito-app
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: herokucito-app-0.2.8
          name: RELEASE-NAME-post-notify
        spec:
          containers:
            - command:
                - ./notify.sh
              env:
                - name: PORT
                  value: "8080"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                - name: OTEL_SERVICE_NAME
                  value: notify
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
              image: myregistry/backend:v1.0.0
              name: notify
              resources:
                limits:
                  cpu: 100m
                  memory: 256Mi
                requests:
                  cpu: 20m
                  memory: 64Mi
          restartPolicy: OnFailure
          serviceAccountName: RELEASE-NAME
