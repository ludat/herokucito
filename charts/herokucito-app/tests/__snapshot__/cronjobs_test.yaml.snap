renders cronjob referencing a service:
  1: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cleanup
        app.kubernetes.io/part-of: herokucito-app
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: herokucito-app-0.2.7
      name: RELEASE-NAME-job-cleanup
    spec:
      concurrencyPolicy: Forbid
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/component: cronjob
                app.kubernetes.io/instance: RELEASE-NAME
                app.kubernetes.io/managed-by: Helm
                app.kubernetes.io/name: cleanup
                app.kubernetes.io/part-of: herokucito-app
                app.kubernetes.io/version: v1.0.0
                helm.sh/chart: herokucito-app-0.2.7
            spec:
              containers:
                - command:
                    - ./cleanup.sh
                  env:
                    - name: PORT
                      value: "8080"
                    - name: OTEL_EXPORTER_OTLP_ENDPOINT
                      value: http://alloy-alloy-receiver.monitoring.svc.cluster.local:4318
                    - name: OTEL_SERVICE_NAME
                      value: backend
                    - name: OTEL_RESOURCE_ATTRIBUTES
                      value: service.namespace=NAMESPACE,service.version=v1.0.0,deployment.environment.name=
                  image: myregistry/backend:v1.0.0
                  name: cleanup
                  resources:
                    limits:
                      cpu: 100m
                      memory: 256Mi
                    requests:
                      cpu: 20m
                      memory: 64Mi
              restartPolicy: OnFailure
              serviceAccountName: RELEASE-NAME
      schedule: 0 2 * * *
      successfulJobsHistoryLimit: 3
